{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/shopify",
      "destination": "/remove-background-for-shopify/",
      "permanent": true
    },
    {
      "source": "/shopify/",
      "destination": "/remove-background-for-shopify/",
      "permanent": true
    },
    {
      "source": "/shopify.html",
      "destination": "/remove-background-for-shopify/",
      "permanent": true
    },
    {
      "source": "/etsy",
      "destination": "/etsy-product-photo-background-remover/",
      "permanent": true
    },
    {
      "source": "/etsy/",
      "destination": "/etsy-product-photo-background-remover/",
      "permanent": true
    },
    {
      "source": "/etsy.html",
      "destination": "/etsy-product-photo-background-remover/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
